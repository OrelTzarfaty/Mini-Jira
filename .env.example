# Copy this file to .env (cp .env.example .env). Never commit .env.
# The values below are safe local defaults. Every variable the code reads is listed here.

# --- The API in local development (npm run dev, npm start, npm run db:seed) ---
# "docker compose up" sets these for the api container in docker-compose.yml instead,
# except LOG_LEVEL, which it reads from here.

NODE_ENV=development
PORT=3000
# fatal, error, warn, info, debug, trace, or silent
LOG_LEVEL=info

# The exact address of the web app, with no path or trailing slash.
CLIENT_ORIGIN=http://localhost:5173

# The API's database address on your computer. It must match the POSTGRES_* values below.
DATABASE_URL=postgresql://minijira:minijira_local_password@localhost:5432/minijira

# --- The PostgreSQL container (npm run db:up and docker compose up) ---
# Set when the database is first created. docker compose up also builds the api
# container's DATABASE_URL from them, so the password must be URL-safe
# (letters, digits, - . _ ~).

POSTGRES_USER=minijira
POSTGRES_PASSWORD=minijira_local_password
POSTGRES_DB=minijira
